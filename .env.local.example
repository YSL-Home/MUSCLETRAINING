# ── AdSense — Slots à créer dans AdSense Console → Annonces → Par unité
# Publisher : ca-pub-6870790039775701
# 1. Va sur https://adsense.google.com → Annonces → Par unité d'annonce
# 2. Crée 4 unités "Affichage" responsives, copie les data-ad-slot de chaque
NEXT_PUBLIC_AD_SLOT_EX_VIDEO=      # Page exercice — après la vidéo YouTube
NEXT_PUBLIC_AD_SLOT_EX_SIDEBAR=    # Page exercice — sidebar
NEXT_PUBLIC_AD_SLOT_BLOG_MID=      # Page article — milieu article
NEXT_PUBLIC_AD_SLOT_BLOG_BAS=      # Page article — sidebar

# ── YouTube Shorts (une seule auth : node scripts/youtube-auth.mjs)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
